{
  "name": "happ-rs-web-assets",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build:cm": "esbuild codemirror-entry.js --bundle --format=iife --target=es2017 --outfile=../assets/codemirror.bundle.js",
    "build:cm:watch": "esbuild codemirror-entry.js --bundle --format=iife --target=es2017 --outfile=../assets/codemirror.bundle.js --watch",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "test:ui:e2e": "playwright test tests/e2e.spec.mjs",
    "test:ui:visual": "playwright test tests/visual.spec.mjs",
    "test:ui:visual:update": "playwright test tests/visual.spec.mjs --update-snapshots",
    "test:ui:update": "playwright test --update-snapshots",
    "test:ui:install": "playwright install chromium",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix"
  },
  "overrides": {
    "flatted": "3.4.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eslint/js": "^9.39.5",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.63.0",
    "axe-core": "^4.13.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "globals": "^17.12.0"
  }
}
